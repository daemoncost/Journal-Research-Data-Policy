#--*- Makefile -*--
#*
# Generate an overview of the collected Journal policy files.
#**

INPUT_DIR  ?= inputs
OUTPUT_DIR ?= outputs

INTERMEDIATE_TSV_DIR ?= ${OUTPUT_DIR}/intermediate-tsv/

INPUT_YAMLS ?= $(shell find -L ${INPUT_DIR}/yaml/ -name '*.yaml')

INTERMEDIATE_YAML ?= ${INPUT_YAMLS:${INPUT_DIR}/%=${INTERMEDIATE_TSV_DIR}/%}
CONVERTED_TSV ?= ${INTERMEDIATE_YAML:%.yaml=%.ttsv}

OUTPUT_ALL_ANSWERS_CSV ?= ${OUTPUT_DIR}/all-answers.csv
OUTPUT_ALL_ANSWERS_TSV ?= ${OUTPUT_DIR}/all-answers.tsv

OUTPUT_SELECTED_ANSWER_CSV ?= ${OUTPUT_DIR}/selected-answer.csv
OUTPUT_SELECTED_ANSWER_TSV ?= ${OUTPUT_DIR}/selected-answer.tsv

.PHONY: all clean distclean mostlyclean cleanAll

all: \
   ${OUTPUT_ALL_ANSWERS_CSV} ${OUTPUT_ALL_ANSWERS_TSV} \
   ${OUTPUT_SELECTED_ANSWER_CSV} ${OUTPUT_SELECTED_ANSWER_TSV}

# Copy temporarily the YAML files to processing directory, to ensure
# uniform file naming:

${INTERMEDIATE_TSV_DIR}/%.yaml: ${INPUT_DIR}/%.yaml
	@mkdir -p $(dir $@)
	cp $< $@

# Collect all answers from the Yaml files into one flat TSV
# table. NB. This table MAY have variable number of columns if some
# questions have more than three answers (represented by the "Other
# Answers" header), so strictly speeking it is not a correct TSV, but
# the subsequent processing will index the trailing columns using the
# "IdxCorrect" value, and there will be a number of provided answers
# in the first column, so that variable column count should not cause
# problems in downstream processing:

${OUTPUT_ALL_ANSWERS_TSV}: $(sort ${CONVERTED_TSV})
	date +"# %F %T %Z" > $@
	head -n 1 $< >> $@
	tail -q -n +3 $^ \
	| sed 's:${INTERMEDIATE_TSV_DIR}:${INPUT_DIR}:' >> $@

%.ttsv: %.yaml
	date +"# %F %T %Z" > $@
	echo "NAnsw,File,Key,Quest,Discrepancies?,IdxCorrect,AnsKeys,Answer1,Answer2,Answer3,Other Answers..." \
	| csv2tab >> $@
	yq -o csv ".[] \
	| [ \
		filename, \
		key + \":\", \
		.text, \
		.has_discrepancies, \
		(.correct_answer | (with (select (. == null); . = \"\"))), \
		[.[] | select (key == \"?\" or key == \"??\") | key + \":\"] | join (\",\"), \
		(.[] | select (key == \"?\" or key == \"??\") | .text) \
	]" \
	$^ \
	| csv2tab \
	| awk -F'\t' '{OFS=FS; print NF-6, $$0}' \
	>> $@

# Select the answer that was marked as "correct" in the "all-answers"
# table:

${OUTPUT_SELECTED_ANSWER_TSV}: ${OUTPUT_ALL_ANSWERS_TSV}
	date +"# %F %T %Z" > $@
	tail -n +2 $< \
	| awk -F'\t' ' \
	    BEGIN { \
		OFS=FS; \
	    } \
	    NR == 1 { \
		print $$1, $$2, $$3, $$4, $$5, $$6, $$7, \
		      "Selected", $$8, $$9, $$10 \
	    } \
	    NR > 1 { \
		idx_correct = ($$6 == "" ? 0 : $$6); \
		\
		print $$1, $$2, $$3, $$4, $$5, $$6, $$7, \
		      $$(8 + idx_correct), \
		      $$8, $$9, $$10 \
	    } \
	' \
	>> $@

# Convert the generated tables to CSV for wider compatibility:

%.csv: %.tsv
	date +"# %F %T %Z" > $@
	tail -n +2 $< | tab2csv >> $@

.PHONY: answers-clean answers-distclean

answers-clean:
	rm -f ${OUTPUT_SELECTED_ANSWER_CSV} ${OUTPUT_SELECTED_ANSWER_TSV}
	find ${INTERMEDIATE_TSV_DIR} -type f | xargs -r rm

answers-distclean:
	rm -f ${OUTPUT_ALL_ANSWERS_CSV} ${OUTPUT_ALL_ANSWERS_TSV}

clean: answers-clean

cleanAll distclean: answers-distclean 

mostlyclean: clean
