#--*- Makefile -*--

#*
# Test pattern rules used to produce TSV tables with encoded answers
# about journal data and software policies.
#**

# To test the answer convesion rules, one can use the comman:
#
#     make tests
#
# When the tests are run once, they will not be re-run unless the
# direcory is cleaned. To re-run the tests, use:
#
#     make test-answers-clean
#     make tests
#
# The default 'make clean' target cleans tests as well.
#
# If some tests fail, they will produce non-empty
# 'tests/outputs/*.diff' files. These files can be inspected usinhg
# the commands:
#
#     make failed
#
# or
#
#     make listdiff
#
# The exact nature of the discrepancy between the expected and the
# generated result can be found by inspecting the differences, e.g.:
#
#     make listdiff | xargs head -n 20
#
# If the output of 'make listdiff' is empty, this means that all tests
# have passed.

TEST_DIR ?= tests
TEST_CASE_DIR ?= ${TEST_DIR}/cases
TEST_OUTP_DIR ?= ${TEST_DIR}/outputs

TEST_YAML_CASES ?= $(wildcard ${TEST_CASE_DIR}/*.yaml)
TEST_TTSV_CASES ?= $(wildcard ${TEST_CASE_DIR}/*.tsv)

TEST_YAML_OUPUTS ?= ${TEST_YAML_CASES:${TEST_CASE_DIR}/%.yaml=${TEST_OUTP_DIR}/%.out}
TEST_TTSV_OUPUTS ?= ${TEST_TTSV_CASES:${TEST_CASE_DIR}/%.tsv=${TEST_OUTP_DIR}/%.out}

TEST_YAML_DIFFS ?= ${TEST_YAML_CASES:${TEST_CASE_DIR}/%.yaml=${TEST_OUTP_DIR}/%.diff}
TEST_TTSV_DIFFS ?= $(subst all-answers,selected-answer,${TEST_TTSV_CASES:${TEST_CASE_DIR}/%.tsv=${TEST_OUTP_DIR}/%.diff})

TEST_DIFFS ?= ${TEST_YAML_DIFFS} ${TEST_TTSV_DIFFS}

.PHONY: all test tests clean

all:

test tests: test-answers

.PHONY: test-answers test-answers-clean

test-answers: ${TEST_DIFFS}

${TEST_OUTP_DIR}/%.diff: ${TEST_CASE_DIR}/%.ttsv ${TEST_OUTP_DIR}/%.out
	@printf "%-30s: " $*
	@diff -I '^#' ${word 1,$^}  ${word 2,$^} > $@; \
	if [ $$? -eq 0 ]; then echo "PASSED"; else echo "FAILED"; cat $@; fi

${TEST_OUTP_DIR}/%.diff: ${TEST_CASE_DIR}/%.tsv ${TEST_OUTP_DIR}/%.out
	@printf "%-30s: " $*
	@diff -I '^#' ${word 1,$^}  ${word 2,$^} > $@; \
	if [ $$? -eq 0 ]; then echo "PASSED"; else echo "FAILED"; cat $@; fi

test-answers-clean:
	rm -f ${TEST_DIFFS}

clean: test-answers-clean
