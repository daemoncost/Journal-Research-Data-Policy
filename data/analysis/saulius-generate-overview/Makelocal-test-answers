#--*- Makefile -*--

#* Test pattern rules used to produce TSV tables with encoded answers
# about journal data and software policies.
#**

TEST_DIR ?= tests
TEST_CASE_DIR ?= ${TEST_DIR}/cases
TEST_OUTP_DIR ?= ${TEST_DIR}/outputs

TEST_YAML_CASES ?= $(wildcard ${TEST_CASE_DIR}/*.yaml)
TEST_TTSV_CASES ?= $(wildcard ${TEST_CASE_DIR}/*.ttsv)

TEST_YAML_OUPUTS ?= ${TEST_YAML_CASES:${TEST_CASE_DIR}/%.yaml=${TEST_OUTP_DIR}/%.out}
TEST_TTSV_OUPUTS ?= ${TEST_TTSV_CASES:${TEST_CASE_DIR}/%.ttsv=${TEST_OUTP_DIR}/%.out}

TEST_YAML_DIFFS ?= ${TEST_YAML_CASES:${TEST_CASE_DIR}/%.yaml=${TEST_OUTP_DIR}/%.diff}
TEST_TTSV_DIFFS ?= ${TEST_TTSV_CASES:${TEST_CASE_DIR}/%.ttsv=${TEST_OUTP_DIR}/%.diff}

TEST_DIFFS ?= ${TEST_YAML_DIFFS} ${TEST_TTSV_DIFFS}

.PHONY: all test tests

all:

test tests: test-answers

.PHONY: test-answers test-answers-clean

test-answers: ${TEST_DIFFS}

${TEST_OUTP_DIR}/%.diff: ${TEST_CASE_DIR}/%.ttsv ${TEST_OUTP_DIR}/%.out
	@printf "%-30s: " $*
	@diff -I '^#' ${word 1,$^}  ${word 2,$^} > $@; \
	if [ $$? -eq 0 ]; then echo "PASSED"; else echo "FAILED"; cat $@; fi

test-answers-clean:
	rm -f ${TEST_DIFFS}
