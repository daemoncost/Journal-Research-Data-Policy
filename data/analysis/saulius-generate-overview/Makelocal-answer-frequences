#--*- Makefile -*--
#*
# Generate an overview of the collected Journal policy files.
#**

OUTPUT_DIR ?= outputs

ANSWER_FREQUENCE_INPUT_TSV ?= ${OUTPUT_DIR}/selected-answer.tsv

ANSWER_FREQUENCE_OUTPUT_TSV ?= ${OUTPUT_DIR}/answer-frequences.tsv

.PHONY: all clean clean-answer-frequences

all: ${ANSWER_FREQUENCE_OUTPUT_TSV}

${ANSWER_FREQUENCE_OUTPUT_TSV}: ${ANSWER_FREQUENCE_INPUT_TSV}
	date +"# %F %T %Z" > $@
	echo "Count\tQuest\tText" >> $@
	awk -F'\t' 'NR > 2 {OFS=FS; print $$3, $$8}' $^ \
	| sort | uniq -c \
	| sed 's/^ *\([0-9]*\) */\1\t/' \
	| sort -nr -k1,1 \
	| sort -s -t "$$(bash -c "echo \$$'\\t'")" -k2,2 \
	>> $@

clean-answer-frequences:
	rm -f ${ANSWER_FREQUENCE_OUTPUT_TSV}

clean: clean-answer-frequences
